# Server-only. Never ship this to the browser or commit a real key.
# Leave it empty while MOCK_META=1.
# Preferred locally. Used as-is when this value is at least 40 characters.
MODEL_API_KEY=

# Optional Vercel workaround. If MODEL_API_KEY is empty or shorter than 40
# characters, the server joins MODEL_API_KEY_0 through MODEL_API_KEY_5 in order.
MODEL_API_KEY_0=
MODEL_API_KEY_1=
MODEL_API_KEY_2=
MODEL_API_KEY_3=
MODEL_API_KEY_4=
MODEL_API_KEY_5=

# 1 = synthetic masks and advice, no calls to api.meta.ai
# 0 = SAM 3.1 segmentation, then Muse Spark triage
MOCK_META=1
